# development | test | production
APP_ENV=development

# 本机 development → http://localhost:3000
# 测试 test → https://test.research.alan-design.win
# 正式 production → https://research.alan-design.win
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# —— 访问监控（多项目共用）——
# 本站埋点 appId
NEXT_PUBLIC_ANALYTICS_APP_ID=research
# 为空则打到本站 /api/track；其他项目可填完整 URL，例如 https://research.alan-design.win/api/track
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
# 允许写入的 appId 列表，逗号分隔
ANALYTICS_APP_IDS=research,logoDesign
# 允许跨域上报的 Origin 列表（逗号分隔，无尾斜杠）
ANALYTICS_CORS_ORIGINS=http://localhost:3000,https://test.research.alan-design.win,https://research.alan-design.win
